<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/ceciliagalvaoo/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="ceciliagalvaoo" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />     <!-- PAT with read:packages, from the environment -->
    </github>
  </packageSourceCredentials>
  <!-- dependency confusion: LendIt.* may ONLY come from our GitHub feed, never from nuget.org -->
  <packageSourceMapping>
    <packageSource key="github"><package pattern="LendIt.*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
